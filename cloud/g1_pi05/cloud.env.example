# 在已登录 AIStudio 的提交容器中设置。只传可在 worker NAS 上读取的凭据文件路径。
export OSS_CONFIG=/input/workspace/.secrets/rlinf-oss.conf
export GPU_COUNT=8
export GPU_TYPE=a100
export RESOURCE_GROUP=digitaltechnology
export CLOUD_WORK=/tmp/rlinf-g1
# 正式训练须提供仅含训练分区的数据归档，根含 datasets.json、norm_stats.json 和 LeRobot 子目录。
# export DATA_URI=oss://tipalgog/sudu/your-training-archive.tar.gz
# export DATA_SHA256=...
# export DATA_BYTES=...
# export VALUE_STEPS=8000 POLICY_STEPS=30000
# export VALUE_MICRO_BATCH=2 POLICY_MICRO_BATCH=2 VALUE_BATCH=256 POLICY_BATCH=256
# export SAVE_INTERVAL=1000 RESUME=0
